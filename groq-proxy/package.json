{
  "name": "groq-proxy",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "mongodb": "^7.2.0",
    "node-fetch": "^2.7.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!tests/**",
      "!coverage/**"
    ],
    "coverageReporters": ["text", "json-summary"],
    "coverageThreshold": {
      "global": {
        "statements": 5,
        "lines": 6
      }
    }
  }
}